# ==============================================================================
# "THE LIVING SKY" — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT FIREBASE CONFIGURATION (Publicly exposed in browser bundle)
# Obtain from: Firebase Console -> Project Settings -> General -> Your Apps
# NOTE: Firebase Auth (Google sign-in) is no longer used.
#       These values are still needed for Firestore read/write.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE FIREBASE ADMIN SDK (Used for Cloudinary sign & Firestore writes)
# Obtain from: Firebase Console -> Project Settings -> Service Accounts -> Generate private key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. CLOUDINARY MEDIA STORAGE
# Obtain from: Cloudinary Console -> Dashboard -> Product Environment Credentials
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# ------------------------------------------------------------------------------
# 4. ADMIN PANEL LOGIN (Password-based — replaces Google Auth)
# These credentials are checked server-side by /api/admin/login
# IMPORTANT: Change JWT_SECRET to a long random string before deploying!
# ------------------------------------------------------------------------------
ADMIN_EMAIL="muhammmadzainumer@gmail.com"
ADMIN_PASSWORD="your-admin-password"
JWT_SECRET="change-this-to-a-long-random-secret-string"

# ------------------------------------------------------------------------------
# 5. GMAIL EMAIL NOTIFICATIONS (Contact form → your Gmail inbox)
# STEP 1: Enable 2-Factor Authentication on your Google Account
# STEP 2: Go to https://myaccount.google.com/apppasswords
# STEP 3: Create an App Password for "Mail" — it's a 16-character code
# STEP 4: Paste that code (no spaces) as GMAIL_APP_PASSWORD below
# ------------------------------------------------------------------------------
GMAIL_USER="muhammmadzainumer@gmail.com"
GMAIL_APP_PASSWORD="xxxx-xxxx-xxxx-xxxx"
