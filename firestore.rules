rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function for checking the sole verified administrator
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email.lower() == "muhammmadzainumer@gmail.com" &&
        request.auth.token.email_verified == true;
    }

    // Public readable portfolio collections; Admin writable only
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /education/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certifications/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact messages:
    // Anyone can create (must have name, email, message, and createdAt)
    // Only admin can read, update (e.g. mark read), or delete
    match /messages/{messageId} {
      allow create: if request.resource.data.name is string &&
                       request.resource.data.name.size() >= 2 &&
                       request.resource.data.email is string &&
                       request.resource.data.email.matches('.*@.*') &&
                       request.resource.data.message is string &&
                       request.resource.data.message.size() >= 10 &&
                       request.resource.data.createdAt is number;
      allow read, update, delete: if isAdmin();
    }
  }
}
